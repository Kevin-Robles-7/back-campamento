# ============================================================
#  Copia este archivo como .env y completa los valores.
#  NUNCA subas el .env al repositorio.
# ============================================================

# ---- Servidor ----
PORT=3000
# Dominios del frontend autorizados, separados por coma.
CORS_ORIGIN=http://localhost:4200

# ---- PostgreSQL (Supabase) ----
# Supabase > Connect > Connection string
#
# DATABASE_URL: pooler en modo TRANSACCION, puerto 6543. La usa la aplicacion.
# DIRECT_URL:   pooler en modo SESION, puerto 5432. Solo para las migraciones,
#               porque el modo transaccion no admite varias sentencias juntas.
#
# Reemplaza [YOUR-PASSWORD] por la contrasena real de la base. Si tiene
# caracteres especiales (@ : / ? # & %) hay que codificarlos en URL:
#   @ -> %40    : -> %3A    / -> %2F    # -> %23    ? -> %3F    & -> %26
DATABASE_URL=
DIRECT_URL=

# Alternativa: valores sueltos (solo si no usas DATABASE_URL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=false
DB_POOL_MAX=5

# ---- Almacenamiento de comprobantes ----
# local -> disco, solo para desarrollo
# s3    -> Supabase Storage o Cloudflare R2 (obligatorio en produccion)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# --- Supabase Storage ---
# Bucket: el nombre que creaste (dejalo PRIVADO).
# Endpoint: Project Settings > Storage > S3 Connection
#   https://<project-ref>.supabase.co/storage/v1/s3
# Credenciales: en la misma pantalla, "New access key".
S3_BUCKET=comprobantes
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Minutos de vigencia de los enlaces a los comprobantes.
S3_URL_MINUTOS=15

# --- Cloudflare R2 (alternativa: mismas variables) ---
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto

# ---- Extraccion de datos del comprobante ----
# auto    -> Tesseract primero (~0,4 s, sin red ni cuota) y Gemini solo si
#            falta algun campo. La opcion mas rapida y la que menos cuota usa.
# gemini  -> Gemini primero, Tesseract como red de seguridad
# openai  -> OpenAI Vision
# manual  -> sin extraccion
OCR_PROVIDER=auto
GEMINI_API_KEY=
# Los Flash-Lite leen igual de bien, responden mas rapido y su cuota gratuita
# es mucho mayor. Si la API responde 404 (modelo retirado) se cambia aqui.
GEMINI_MODELO=gemini-3.5-flash-lite
OPENAI_API_KEY=

# ---- Limpieza de borradores ----
# Minutos que se conserva un comprobante sin inscripcion confirmada.
MINUTOS_BORRADOR=45
